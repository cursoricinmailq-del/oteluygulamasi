@page "/"
@using OtelUygulamasi.Models
@using OtelUygulamasi.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<!-- Hero / Karşılama Alanı -->
<div class="bg-primary text-white py-5 mb-5 rounded-3 shadow">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Lüks ve Konforun Adresi</h1>
        <p class="lead">Tarihlerinizi seçin, size en uygun odayı anında rezerve edin.</p>
    </div>
</div>

<div class="container mb-5">
    <!-- 📅 1. TARİH BAZLI ARAMA VE FİLTRELEME PANELLERİ -->
    <div class="card shadow-lg border-0 mb-5 mt-n5 position-relative z-index-2">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3 text-dark">🔍 Müsaitlik Kontrolü</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giriş Tarihi</label>
                    <input type="date" class="form-control form-control-lg" @bind="checkInDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Çıkış Tarihi</label>
                    <input type="date" class="form-control form-control-lg" @bind="checkOutDate" min="@checkInDate.AddDays(1).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-dark btn-lg w-100 fw-bold" @onclick="SearchAvailableRooms">
                        Müsait Odaları Ara
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Başarılı Rezervasyon Bildirimi -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show p-4 shadow-sm" role="alert">
            <h4 class="alert-heading">🎉 Rezervasyonunuz Alındı!</h4>
            <p class="mb-0">@successMessage</p>
            <p class="small text-muted mt-2">✉️ Onay e-postası belirtilen e-posta adresinize gönderilmiştir.</p>
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- 🛍️ 2. MÜŞTERİNİN GÖRECEĞİ ODA VİTRİNİ -->
    <h3 class="fw-bold mb-4">Müsait Odalarımız</h3>
    <div class="row g-4">
        @if (!availableRooms.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="fs-4 text-muted">Seçtiğiniz tarihler arasında müsait oda bulunamadı veya arama yapmadınız.</p>
            </div>
        }
        else
        {
            @foreach (var room in availableRooms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow border-0 rounded-3 overflow-hidden">
                        <img src="@room.ImageUrl" class="card-img-top" style="height: 220px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold">@room.Name</h5>
                            <span class="badge bg-secondary mb-2 w-auto me-auto">👥 Maksimum @room.Occupancy Kişi</span>
                            <div class="my-3">
                                <span class="fs-3 fw-bold text-success">₺@room.RegularRate</span>
                                <span class="text-muted small">/ gece</span>
                            </div>
                            <button class="btn btn-primary btn-lg w-100 fw-bold mt-auto" @onclick="() => SelectRoomForBooking(room)">
                                🏨 Hemen Rezerve Et
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- 💳 REZERVASYON & HIZLI ÖDEME MODALI (POPUP) -->
@if (selectedRoom != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Oda Rezervasyonu: @selectedRoom.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedRoom = null"></button>
                </div>
                <EditForm Model="booking" OnValidSubmit="CompleteBooking">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="alert alert-info small">
                            📅 <strong>Tarihler:</strong> @checkInDate.ToShortDateString() - @checkOutDate.ToShortDateString() (@CalculateNights() Gece)<br />
                            💰 <strong>Toplam Tutar:</strong> ₺@CalculateTotalPrice()
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Adınız Soyadınız</label>
                            <InputText class="form-control" @bind-Value="booking.CustomerName" placeholder="Ahmet Yılmaz" />
                            <ValidationMessage For="@(() => booking.CustomerName)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">E-posta Adresiniz (Onay Maili İçin)</label>
                            <InputText class="form-control" @bind-Value="booking.CustomerEmail" placeholder="ahmet@gmail.com" />
                            <ValidationMessage For="@(() => booking.CustomerEmail)" class="text-danger small" />
                        </div>

                        <hr />
                        <h6 class="fw-bold mb-3">💳 Ödeme Bilgileri (Simülasyon)</h6>
                        <div class="mb-3">
                            <input type="text" class="form-control" placeholder="Kart Üzerindeki İsim" required />
                        </div>
                        <div class="row g-2">
                            <div class="col-8">
                                <input type="text" class="form-control" placeholder="**** **** **** ****" maxLength="16" required />
                            </div>
                            <div class="col-4">
                                <input type="text" class="form-control" placeholder="CVC" maxLength="3" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => selectedRoom = null">İptal</button>
                        <button type="submit" class="btn btn-success fw-bold">💳 ₺@CalculateTotalPrice() Öde ve Bitir</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private DateTime checkInDate = DateTime.Today;
    private DateTime checkOutDate = DateTime.Today.AddDays(2);

    private List<HotelRoom> availableRooms = new();
    private HotelRoom? selectedRoom;
    private RoomBooking booking = new();
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await SearchAvailableRooms();
    }

    private async Task SearchAvailableRooms()
    {
        using var context = DbFactory.CreateDbContext();

        // Dolu odaların ID'lerini bul
        var bookedRoomIds = await context.Bookings
            .Where(b => (checkInDate < b.CheckOutDate) && (checkOutDate > b.CheckInDate))
            .Select(b => b.RoomId)
            .ToListAsync();

        // Sadece seçili tarihlerde dolu olmayan odaları getir
        availableRooms = await context.HotelRooms
            .Where(r => !bookedRoomIds.Contains(r.Id))
            .ToListAsync();
    }

    private void SelectRoomForBooking(HotelRoom room)
    {
        selectedRoom = room;
        booking = new RoomBooking
        {
            RoomId = room.Id,
            CheckInDate = checkInDate,
            CheckOutDate = checkOutDate
        };
    }

    private int CalculateNights() => (checkOutDate - checkInDate).Days > 0 ? (checkOutDate - checkInDate).Days : 1;
    private double CalculateTotalPrice() => selectedRoom != null ? selectedRoom.RegularRate * CalculateNights() : 0;

    private async Task CompleteBooking()
    {
        using var context = DbFactory.CreateDbContext();

        booking.TotalPrice = CalculateTotalPrice();
        booking.IsPaid = true;

        context.Bookings.Add(booking);
        await context.SaveChangesAsync();

        successMessage = $"Sayın {booking.CustomerName}, {selectedRoom?.Name} için rezervasyonunuz başarıyla oluşturuldu!";
        selectedRoom = null;

        await SearchAvailableRooms(); // Listeyi güncelle
    }
}