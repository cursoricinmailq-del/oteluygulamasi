@page "/reservations"
@using OtelUygulamasi.Models
@using OtelUygulamasi.Data
@using OtelUygulamasi.Services
@using Microsoft.EntityFrameworkCore
@inject UserSession Session
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<HeadContent>
    <title>Rezervasyonlar</title>
    <meta name="description" content="Rol bazlı rezervasyon yönetimi; müşteri veya admin olarak mevcut rezervasyonları görüntüleyin." />
</HeadContent>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold">Rezervasyon Yönetimi</h2>
            <p class="text-muted mb-0">Giriş yaparak müşteri veya admin deneyimi elde edin.</p>
        </div>
        @if (Session.IsAuthenticated)
        {
            <button class="btn btn-outline-secondary" @onclick="Logout">Çıkış Yap</button>
        }
    </div>

    @if (!Session.IsAuthenticated)
    {
        <div class="card shadow-sm rounded-4 p-4">
            <h4 class="fw-bold mb-3">Giriş Yap</h4>
            <EditForm Model="loginModel" OnValidSubmit="LoginUser">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Kullanıcı Adı</label>
                        <InputText class="form-control" @bind-Value="loginModel.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">E-posta</label>
                        <InputText class="form-control" @bind-Value="loginModel.Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Parola</label>
                        <InputText type="password" class="form-control" @bind-Value="loginModel.Password" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4 fw-bold">Giriş Yap</button>
            </EditForm>
        </div>
    }
    else
    {
        <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm rounded-4 p-4 h-100">
                        <h5 class="fw-semibold">Hoş geldiniz, @Session.UserName</h5>
                        <p class="text-muted mb-2">Rolünüz: <strong>@Session.Role</strong></p>
                        <p class="text-muted mb-0">Kayıtlı e-postanız: <strong>@Session.Email</strong></p>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card shadow-sm rounded-4 p-4 h-100">
                        <h4 class="fw-bold mb-3">Aktif Rezervasyonlar</h4>
                        @if (!reservations.Any())
                        {
                            <div class="alert alert-info mb-0">Henüz görüntülenecek rezervasyon bulunamadı.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Oda</th>
                                            <th>Tarih</th>
                                            <th>Toplam</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var booking in reservations)
                                        {
                                            <tr>
                                                <td>@booking.Room?.Name</td>
                                                <td>@booking.CheckInDate.ToShortDateString() - @booking.CheckOutDate.ToShortDateString()</td>
                                                <td>₺@booking.TotalPrice.ToString("N0")</td>
                                                <td>@(booking.IsPaid ? "Ödendi" : "Beklemede")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (Session.IsAdmin)
            {
                <div class="row g-4 mt-4">
                    <div class="col-lg-6">
                        <div class="card shadow-sm rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="fw-bold mb-0">İletişim Mesajları (Admin)</h4>
                                <div>
                                    <select class="form-select form-select-sm" style="width:160px;" @bind="messageFilter">
                                        <option value="all">Tümü</option>
                                        <option value="unread">Okunmamış</option>
                                        <option value="read">Okunmuş</option>
                                    </select>
                                </div>
                            </div>
                            @if (!filteredMessages.Any())
                            {
                                <div class="alert alert-secondary">Filtreye göre mesaj yok.</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var m in filteredMessages)
                                    {
                                        <div class="list-group-item mb-2">
                                            <div class="d-flex justify-content-between">
                                                <strong>@m.Name</strong>
                                                <small class="text-muted">@m.CreatedAt.ToLocalTime().ToString("g")</small>
                                            </div>
                                            <div class="small text-muted">@m.Email • @m.Subject</div>
                                            <p class="mt-2 mb-1">@m.Message</p>
                                            <div class="mt-2 d-flex gap-2">
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleRead(m.Id)">@(m.IsRead ? "Mark As Unread" : "Mark As Read")</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMessage(m.Id)">Sil</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card shadow-sm rounded-4 p-4">
                            <h4 class="fw-bold mb-3">Rezervasyon Yönetimi (Admin)</h4>
                            <div class="mb-3 d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="ExportReservationsCsv">CSV Dışa Aktar</button>
                                <a class="btn btn-outline-secondary btn-sm" href="/admin-analytics">Analitik Görüntüle</a>
                            </div>
                            @if (!reservations.Any())
                            {
                                <div class="alert alert-secondary">Görüntülenecek rezervasyon yok.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Oda</th>
                                                <th>Tarih</th>
                                                <th>Toplam</th>
                                                <th>Durum</th>
                                                <th>İşlem</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var booking in reservations)
                                            {
                                                <tr>
                                                    <td>@booking.Room?.Name</td>
                                                    <td>@booking.CheckInDate.ToShortDateString() - @booking.CheckOutDate.ToShortDateString()</td>
                                                    <td>₺@booking.TotalPrice.ToString("N0")</td>
                                                    <td>
                                                        @if (booking.IsCancelled)
                                                        {
                                                            <span class="badge bg-danger">İptal</span>
                                                        }
                                                        else if (booking.IsConfirmed)
                                                        {
                                                            <span class="badge bg-success">Onaylı</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">Beklemede</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="d-flex gap-2">
                                                            <button class="btn btn-sm btn-success" @onclick="() => ApproveBooking(booking.Id)">Onayla</button>
                                                            <button class="btn btn-sm btn-danger" @onclick="() => CancelBooking(booking.Id)">İptal Et</button>
                                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadInvoice(booking.Id)">Fatura</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
    }
</div>

@code {
    private LoginModel loginModel = new();
    private List<RoomBooking> reservations = new();
    private List<OtelUygulamasi.Models.ContactMessage> contactMessages = new();
    private string messageFilter = "all";

    private IEnumerable<OtelUygulamasi.Models.ContactMessage> filteredMessages => contactMessages
        .Where(m => messageFilter == "all" || (messageFilter == "unread" && !m.IsRead) || (messageFilter == "read" && m.IsRead));

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await LoadReservations();
        }
    }

    private async Task LoginUser()
    {
        // Hardcoded admin credentials: username 'admin' and password 'ritranks'
        if (loginModel.Name == "admin" && loginModel.Password == "ritranks")
        {
            Session.Login("admin", loginModel.Email, "Admin");
        }
        else
        {
            // default to Customer role
            Session.Login(loginModel.Name, loginModel.Email, "Customer");
        }

        await LoadReservations();
    }

    private async Task LoadReservations()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Bookings.Include(b => b.Room).AsQueryable();

        if (!Session.IsAdmin)
        {
            query = query.Where(b => b.CustomerEmail == Session.Email);
        }

        reservations = await query.OrderByDescending(b => b.CheckInDate).ToListAsync();
        if (Session.IsAdmin)
        {
            contactMessages = await context.ContactMessages.OrderByDescending(m => m.CreatedAt).ToListAsync();
        }
    }

    private async Task ToggleRead(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var msg = await context.ContactMessages.FindAsync(id);
        if (msg != null)
        {
            msg.IsRead = !msg.IsRead;
            await context.SaveChangesAsync();
            contactMessages = await context.ContactMessages.OrderByDescending(m => m.CreatedAt).ToListAsync();
            StateHasChanged();
        }
    }

    private async Task DeleteMessage(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var msg = await context.ContactMessages.FindAsync(id);
        if (msg != null)
        {
            context.ContactMessages.Remove(msg);
            await context.SaveChangesAsync();
            contactMessages = await context.ContactMessages.OrderByDescending(m => m.CreatedAt).ToListAsync();
            StateHasChanged();
        }
    }

    private async Task ApproveBooking(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var b = await context.Bookings.FindAsync(id);
        if (b != null)
        {
            b.IsConfirmed = true;
            b.IsCancelled = false;
            await context.SaveChangesAsync();
            await LoadReservations();
        }
    }

    private async Task CancelBooking(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var b = await context.Bookings.FindAsync(id);
        if (b != null)
        {
            b.IsCancelled = true;
            b.IsConfirmed = false;
            await context.SaveChangesAsync();
            await LoadReservations();
        }
    }

    private async Task ExportReservationsCsv()
    {
        using var context = DbFactory.CreateDbContext();
        var data = await context.Bookings.Include(b => b.Room).ToListAsync();
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Id,Room,CheckIn,CheckOut,Customer,Email,TotalPrice,Status");
        foreach (var b in data)
        {
            var status = b.IsCancelled ? "Cancelled" : b.IsConfirmed ? "Confirmed" : "Pending";
            csv.AppendLine($"{b.Id},\"{b.Room?.Name}\",{b.CheckInDate:yyyy-MM-dd},{b.CheckOutDate:yyyy-MM-dd},\"{b.CustomerName}\",\"{b.CustomerEmail}\",{b.TotalPrice},{status}");
        }

        await JS.InvokeVoidAsync("siteHelpers.downloadFile", "reservations.csv", csv.ToString(), "text/csv");
    }

    private async Task DownloadInvoice(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var b = await context.Bookings.Include(x => x.Room).FirstOrDefaultAsync(x => x.Id == id);
        if (b == null) return;

        var html = $"<html><body><h2>Fatura - Rezervasyon #{b.Id}</h2><p>Oda: {b.Room?.Name}</p><p>Müşteri: {b.CustomerName}</p><p>E-posta: {b.CustomerEmail}</p><p>Tarih: {b.CheckInDate:yyyy-MM-dd} - {b.CheckOutDate:yyyy-MM-dd}</p><p>Toplam: ₺{b.TotalPrice:N0}</p></body></html>";
        await JS.InvokeVoidAsync("siteHelpers.downloadFile", $"invoice_{b.Id}.html", html, "text/html");
    }

    private void Logout()
    {
        Session.Logout();
        reservations.Clear();
    }

    private class LoginModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
