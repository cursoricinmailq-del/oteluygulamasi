@page "/reservations"
@using OtelUygulamasi.Models
@using OtelUygulamasi.Data
@using OtelUygulamasi.Services
@using Microsoft.EntityFrameworkCore
@inject UserSession Session
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<HeadContent>
    <title>Rezervasyonlar</title>
    <meta name="description" content="Rol bazlı rezervasyon yönetimi; müşteri veya admin olarak mevcut rezervasyonları görüntüleyin." />
</HeadContent>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold">Rezervasyon Yönetimi</h2>
            <p class="text-muted mb-0">Giriş yaparak müşteri veya admin deneyimi elde edin.</p>
        </div>
        @if (Session.IsAuthenticated)
        {
            <button class="btn btn-outline-secondary" @onclick="Logout">Çıkış Yap</button>
        }
    </div>

    @if (!Session.IsAuthenticated)
    {
        <div class="card shadow-sm rounded-4 p-4">
            <h4 class="fw-bold mb-3">Giriş Yap</h4>
            <EditForm Model="loginModel" OnValidSubmit="LoginUser">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Ad Soyad</label>
                        <InputText class="form-control" @bind-Value="loginModel.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">E-posta</label>
                        <InputText class="form-control" @bind-Value="loginModel.Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Rol Seçin</label>
                        <select class="form-select" @bind="loginModel.Role">
                            <option value="Customer">Müşteri</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4 fw-bold">Giriş Yap</button>
            </EditForm>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-semibold">Hoş geldiniz, @Session.UserName</h5>
                    <p class="text-muted mb-2">Rolünüz: <strong>@Session.Role</strong></p>
                    <p class="text-muted mb-0">Kayıtlı e-postanız: <strong>@Session.Email</strong></p>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card shadow-sm rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3">Aktif Rezervasyonlar</h4>
                    @if (!reservations.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz görüntülenecek rezervasyon bulunamadı.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Oda</th>
                                        <th>Tarih</th>
                                        <th>Toplam</th>
                                        <th>Durum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in reservations)
                                    {
                                        <tr>
                                            <td>@booking.Room?.Name</td>
                                            <td>@booking.CheckInDate.ToShortDateString() - @booking.CheckOutDate.ToShortDateString()</td>
                                            <td>₺@booking.TotalPrice.ToString("N0")</td>
                                            <td>@(booking.IsPaid ? "Ödendi" : "Beklemede")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LoginModel loginModel = new();
    private List<RoomBooking> reservations = new();

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await LoadReservations();
        }
    }

    private async Task LoginUser()
    {
        Session.Login(loginModel.Name, loginModel.Email, loginModel.Role);
        await LoadReservations();
    }

    private async Task LoadReservations()
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Bookings.Include(b => b.Room).AsQueryable();

        if (!Session.IsAdmin)
        {
            query = query.Where(b => b.CustomerEmail == Session.Email);
        }

        reservations = await query.OrderByDescending(b => b.CheckInDate).ToListAsync();
    }

    private void Logout()
    {
        Session.Logout();
        reservations.Clear();
    }

    private class LoginModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "Customer";
    }
}
