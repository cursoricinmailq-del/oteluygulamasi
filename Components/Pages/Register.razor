@page "/register"
@using OtelUygulamasi.Services
@inject UserAccountService AccountService
@inject UserSession Session
@inject NavigationManager Nav
@inject LocalizationService L

<HeadContent>
    <title>Hesap Oluştur</title>
</HeadContent>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3 text-center">@L["RegisterTitle"]</h2>
                    <p class="text-muted text-center mb-4">@L["RegisterDescription"]</p>
                    <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">@L["UsernameLabel"]</label>
                            <InputText class="form-control" @bind-Value="registerModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["EmailLabel"]</label>
                            <InputText type="email" class="form-control" @bind-Value="registerModel.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["PasswordLabel"]</label>
                            <InputText type="password" class="form-control" @bind-Value="registerModel.Password" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["ConfirmPasswordLabel"]</label>
                            <InputText type="password" class="form-control" @bind-Value="registerModel.ConfirmPassword" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">@L["RegisterButton"]</button>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success mt-3">@successMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(registerModel.Name) || string.IsNullOrWhiteSpace(registerModel.Email) || string.IsNullOrWhiteSpace(registerModel.Password))
        {
            errorMessage = L["RequiredFieldsError"];
            return;
        }

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = L["PasswordMismatchError"];
            return;
        }

        var (success, error) = await AccountService.CreateUserAsync(registerModel.Name, registerModel.Email, registerModel.Password);
        if (!success)
        {
            errorMessage = error switch
            {
                "UsernameAlreadyExists" => L["UsernameExistsError"],
                "EmailAlreadyExists" => L["EmailExistsError"],
                _ => L["RegistrationFailed"]
            };
            return;
        }

        var user = await AccountService.ValidateCredentialsAsync(registerModel.Name, registerModel.Password);
        if (user != null)
        {
            Session.Login(user.UserName, user.Email, user.Role);
            Nav.NavigateTo("/reservations");
        }
    }

    private class RegisterModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
