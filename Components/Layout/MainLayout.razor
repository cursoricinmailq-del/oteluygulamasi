@inherits LayoutComponentBase
@inject OtelUygulamasi.Services.UserSession Session
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 py-3 d-flex justify-content-between align-items-center shadow-sm bg-white">
            <div class="d-flex gap-3 align-items-center">
                <span class="badge bg-primary py-2 px-3">OtelRezervasyon</span>
                <span class="text-muted small">Profesyonel otel yönetimi ve rezervasyon deneyimi</span>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a class="text-decoration-none text-primary fw-bold" href="about">Hakkımızda</a>
                @if (Session.IsAuthenticated)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-secondary">@Session.UserName</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Logout">Çıkış</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="GoToReservations">Giriş / Kayıt</button>
                }
            </div>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/");
    }

    private void GoToReservations()
    {
        Nav.NavigateTo("/reservations");
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
