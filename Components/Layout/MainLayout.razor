@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 py-3 d-flex justify-content-between align-items-center shadow-sm bg-white">
            <div class="d-flex gap-3 align-items-center">
                <span class="badge bg-primary py-2 px-3">OtelRezervasyon</span>
                <span class="text-muted small">Profesyonel otel yönetimi ve rezervasyon deneyimi</span>
            </div>
            <a class="text-decoration-none text-primary fw-bold" href="about">Hakkımızda</a>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
